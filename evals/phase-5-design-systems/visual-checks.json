        "active": "<body>\n  <div class=\"page\">\n    <header>\n      <p class=\"identity\">Cedar Desk</p>\n      <p class=\"sample\">Sample data</p>\n    </header>\n    <main>\n      <section id=\"projects\" aria-labelledby=\"projects-title\">\n        <h1 id=\"projects-title\" tabindex=\"-1\">Projects</h1>\n        <div class=\"panel\">\n          <ul>\n            <li><a class=\"project-row\" id=\"orchard-link\" href=\"#project/orchard-notes\">Orchard notes</a></li>\n            <li><a class=\"project-row\" id=\"harbor-link\" href=\"#project/harbor-review\">Harbor review</a></li>\n          </ul>\n        </div>\n      </section>\n      <section id=\"detail\" aria-labelledby=\"detail-title\" hidden=\"\">\n        <a class=\"button back\" href=\"#projects\">Back to Projects</a>\n        <h1 id=\"detail-title\" tabindex=\"-1\"></h1>\n        <div class=\"panel\">\n          <dl>\n            <dt>Summary</dt>\n            <dd id=\"summary\"></dd>\n            <dt>Owner</dt>\n            <dd id=\"owner\"></dd>\n          </dl>\n        </div>\n      </section>\n    </main>\n  </div>\n  <script>\n    (() => {\n      'use strict';\n      const projects = {\n        'orchard-notes': {name:'Orchard notes', summary:'Review the supplied observation notes.', owner:'Sam', link:'orchard-link'},\n        'harbor-review': {name:'Harbor review', summary:'Review the supplied harbor notes.', owner:'Priya', link:'harbor-link'}\n      };\n      const list = document.getElementById('projects');\n      const detail = document.getElementById('detail');\n      const title = document.getElementById('detail-title');\n      let lastProject = null;\n      function render(moveFocus) {\n        const route = window.location.hash;\n        const project = route.startsWith('#project/') ? projects[route.slice(9)] : null;\n        list.hidden = Boolean(project);\n        detail.hidden = !project;\n        if (project) {\n          lastProject = project;\n          title.textContent = project.name;\n          document.getElementById('summary').textContent = project.summary;\n          document.getElementById('owner').textContent = project.owner;\n          document.title = project.name + ' \u00b7 Cedar Desk';\n          if (moveFocus) title.focus();\n        } else {\n          document.title = 'Projects \u00b7 Cedar Desk';\n          if (moveFocus) document.getElementById(lastProject ? lastProject.link : 'projects-title').focus();\n        }\n      }\n      window.addEventListener('hashchange', () => render(true));\n      render(false);\n    })();\n  </script>\n\n\n</body>",
