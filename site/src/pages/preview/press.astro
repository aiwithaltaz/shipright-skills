---
import '@fontsource/source-serif-4/latin-400.css'
import '@fontsource/ibm-plex-sans/latin-400.css'
import '@fontsource/ibm-plex-sans/latin-500.css'
import '../../styles/base.css'
import '../../styles/press.css'
import Frame from '../../layouts/Frame.astro'
import Gallery from '../../components/Gallery.astro'
import Install from '../../components/Install.astro'
import { cases, trialNote } from '../../data/gallery.js'

const marketing = cases.find((item) => item.id === 'marketing')
---
<Frame
  title="Press, a proposed ShipRight direction"
  description="Proposed look: desktop and phone comparisons under a nameplate. Not the approved site."
  theme="press"
  motion="press"
>
  <div class="readbar" aria-hidden="true"></div>
  <header class="top">
    <a class="back" href="/">All directions</a>
    <p class="mark">Press, proposed</p>
  </header>
  <main id="content">
    <section class="nameplate">
      <div>
        <h1>Context before generate.<br />Product before pixels.</h1>
        <p class="deck">One skill for a website, an app, or a screen.</p>
      </div>
      <a class="btn" href="#install">Install</a>
    </section>
    <section class="pair-wrap">
      <div class="pair">
        {marketing.images.map((image) => (
          <figure>
            <img
              src={image.src}
              width={image.width}
              height={image.height}
              alt={image.alt}
            />
            <figcaption>
              {image.label}. Marketing site, grid re-run. Checked, not graded. 0.6.2 on the left. 1.0 on the right.
            </figcaption>
          </figure>
        ))}
      </div>
    </section>
    <section class="band">
      <h2>Before and after</h2>
      <p class="note">{trialNote} The graded marketing run was a different build: 22 and 28.</p>
      <Gallery variant="press" />
    </section>
    <section class="band" id="install">
      <h2>Install</h2>
      <p class="lead">ShipRight 1.1.0. Paths, commands, and the release files.</p>
      <Install variant="press" />
    </section>
  </main>
</Frame>
<script>
  import '../../scripts/motion.js'
</script>
