---
import '../styles/base.css'
import '../styles/chooser.css'
import Frame from '../layouts/Frame.astro'
import { links } from '../data/install.js'
---
<Frame
  title="ShipRight directions"
  description="Three proposed looks for the ShipRight site. None is approved."
  theme="chooser"
>
  <header class="top">
    <p class="mark">ShipRight 1.1.0</p>
    <a href={links.github}>GitHub</a>
  </header>
  <main id="content">
    <div class="intro">
      <h1>Three directions</h1>
      <p>None is approved. Each page is a hero, the real before and after gallery, and the 1.1 install lines.</p>
    </div>
    <nav class="picks" aria-label="Directions">
      <a class="pick" href="/preview/split">
        <strong>Split</strong>
        <span class="why">Instrument Serif and Instrument Sans. Cool gray, navy action. The comparison sits beside the headline. A line draws down the middle.</span>
      </a>
      <a class="pick" href="/preview/night">
        <strong>Night</strong>
        <span class="why">Manrope only. Near-black field, paper action. The comparison is full width under the headline and settles as you scroll.</span>
      </a>
      <a class="pick" href="/preview/press">
        <strong>Press</strong>
        <span class="why">Source Serif 4 and IBM Plex Sans. White page, black action, tight rules. Desktop and phone comparisons sit under the nameplate. A reading rule tracks scroll.</span>
      </a>
    </nav>
  </main>
</Frame>
