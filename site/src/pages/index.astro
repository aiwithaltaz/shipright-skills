---
import '../styles/base.css'
import '../styles/chooser.css'
import Frame from '../layouts/Frame.astro'
import { links } from '../data/install.js'
---
<Frame
  title="ShipRight directions"
  description="Three proposed looks for the ShipRight site. None is approved."
  theme="chooser"
>
  <header class="top">
    <p class="mark">ShipRight 1.1.0</p>
    <a href={links.github}>GitHub</a>
  </header>
  <main id="content">
    <div class="intro">
      <h1>Three directions</h1>
      <p>None is approved. Each one is open: a floating nav, a 3D hero, the real comparisons, and the 1.1 install lines.</p>
    </div>
    <nav class="picks" aria-label="Directions">
      <a class="pick" href="/preview/air">
        <strong>Air</strong>
        <span class="why">White field. Syne, two wide lines. A pale knot turns in a soft stage.</span>
      </a>
      <a class="pick" href="/preview/depth">
        <strong>Depth</strong>
        <span class="why">Navy field. Familjen Grotesk in caps. A cool solid turns as you scroll. The install lines stay quiet.</span>
      </a>
      <a class="pick" href="/preview/grid">
        <strong>Grid</strong>
        <span class="why">Cool gray field. Newsreader beside a wire sphere, on a hairline grid.</span>
      </a>
    </nav>
  </main>
</Frame>
