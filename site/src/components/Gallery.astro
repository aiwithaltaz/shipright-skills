---
import { cases } from '../data/gallery.js'

const { variant } = Astro.props
---
{variant === 'split' && (
  <div class="cases">
    {cases.map((item) => (
      <article class="case">
        <div>
          <h3>{item.title}</h3>
          <p>{item.text} <a href={item.source}>Source</a></p>
        </div>
        <div class="shots">
          {item.images.map((image) => (
            <figure class={image.phone ? 'phone-shot' : undefined}>
              <img src={image.src} width={image.width} height={image.height} alt={image.alt} />
              <figcaption>{image.label}. 0.6.2 on the left. 1.0 on the right.</figcaption>
            </figure>
          ))}
        </div>
      </article>
    ))}
  </div>
)}

{variant === 'night' && (
  <div>
    {cases.map((item) => (
      <article class="case">
        <div class="case-copy">
          <h3>{item.title}</h3>
          <p>{item.text} <a href={item.source}>Source</a></p>
        </div>
        {item.images.filter((image) => !image.phone).map((image) => (
          <img class="wide" src={image.src} width={image.width} height={image.height} alt={image.alt} />
        ))}
        <div class="case-copy">
          {item.images.filter((image) => image.phone).map((image) => (
            <figure class="phone-shot">
              <img src={image.src} width={image.width} height={image.height} alt={image.alt} />
              <figcaption>{image.label}. 0.6.2 on the left. 1.0 on the right.</figcaption>
            </figure>
          ))}
        </div>
      </article>
    ))}
  </div>
)}

{variant === 'press' && (
  <div>
    {cases.map((item) => (
      <article class="case">
        <div class="case-head">
          <h3>{item.title}</h3>
        </div>
        <div class="shots">
          {item.images.map((image) => (
            <figure class={image.phone ? 'phone-shot' : undefined}>
              <img src={image.src} width={image.width} height={image.height} alt={image.alt} />
              <figcaption>{image.label}</figcaption>
            </figure>
          ))}
        </div>
        <p>{item.text} <a href={item.source}>Source</a></p>
      </article>
    ))}
  </div>
)}
