---
import Frame from '../layouts/Frame.astro'
import Install from './Install.astro'
import { cases, trialNote } from '../data/gallery.js'
import { links } from '../data/install.js'

const { theme, title, description } = Astro.props

function primary(item) {
  if (item.id === 'mobile') return item.images.find((image) => image.phone)
  return item.images.find((image) => !image.phone)
}
---
<Frame title={title} description={description} theme={theme} motion={theme}>
  <header class="nav">
    <a class="brand" href="/">ShipRight</a>
    <a href="#gallery">Gallery</a>
    <a href="#install">Install</a>
    <a href={links.github}>GitHub</a>
  </header>
  <main id="content">
    <section class="hero" id="hero">
      <h1>Context before generate.<br />Product before pixels.</h1>
      <div class="hero-actions">
        <p class="deck">One skill for a website, an app, or a screen.</p>
        <a class="btn" href="#install">Install</a>
      </div>
      <div class="stage" data-stage>
        <canvas data-scene={theme} aria-hidden="true"></canvas>
      </div>
    </section>

    <section class="section about">
      <p class="lede">It writes the pack before anyone builds the look.</p>
      <ul class="slop">
        <li>No invented metrics, quotes, logos, or prices.</li>
        <li>No gradient text, glow, or rows of icon cards.</li>
        <li>Your design system wins.</li>
        <li>The look waits for your OK.</li>
      </ul>
    </section>

    <section class="section" id="gallery">
      <div class="rule" aria-hidden="true"></div>
      <h2>Before and after</h2>
      <p class="note">{trialNote}</p>
      {cases.map((item) => {
        const image = primary(item)
        return (
          <article class="case">
            <h3>{item.title}</h3>
            <p>{item.text} <a href={item.source}>Source</a></p>
            <figure>
              <img src={image.src} width={image.width} height={image.height} alt={image.alt} />
              <figcaption>{image.label}. 0.6.2 on the left. 1.0 on the right.</figcaption>
            </figure>
          </article>
        )
      })}
    </section>

    <section class="section" id="ivc">
      <h2>IVC 2026</h2>
      <p class="note">Historical example. The images are not added yet.</p>
      <div class="slots">
        <div class="slot">
          <h3>Registration search results</h3>
          <p>Not added yet.</p>
        </div>
        <div class="slot">
          <h3>Reports</h3>
          <p>Not added yet.</p>
        </div>
      </div>
    </section>

    <section class="section" id="install">
      <h2>Install</h2>
      <p class="note">ShipRight 1.1.0. Copy the line for your tool.</p>
      <Install />
    </section>
  </main>
</Frame>
<script>
  import '../scripts/live.js'
</script>
