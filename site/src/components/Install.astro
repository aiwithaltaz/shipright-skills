---
import { skillsCommand, pluginSteps, tools, files, globalNote } from '../data/install.js'

const pluginCopy = pluginSteps.join('\n')
---
<div class="unit">
  <p class="name">Any tool</p>
  <pre><code>{skillsCommand}</code></pre>
  <p class="detail">{globalNote}</p>
  <button type="button" class="copy" data-copy={skillsCommand}>Copy</button>
  <p class="status" data-status role="status"></p>
</div>
<div class="unit">
  <p class="name">Claude Code</p>
  <pre><code>{pluginCopy}</code></pre>
  <p class="detail">Run both lines in Claude Code.</p>
  <button type="button" class="copy" data-copy={pluginCopy}>Copy</button>
  <p class="status" data-status role="status"></p>
</div>
{tools.map((tool) => (
  <div class="unit">
    <p class="name">{tool.tool}</p>
    <pre><code>{tool.command}</code></pre>
    {tool.note && <p class="detail">{tool.note}</p>}
    <button type="button" class="copy" data-copy={tool.command}>Copy</button>
    <p class="status" data-status role="status"></p>
  </div>
))}
{files.map((file) => (
  <div class="unit">
    <p class="name">{file.tool}</p>
    <a class="file-link" href={file.href}>{file.label}</a>
    <p class="detail">{file.detail}</p>
    <button type="button" class="copy" data-copy={file.href}>Copy link</button>
    <p class="status" data-status role="status"></p>
  </div>
))}
